{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "antipode": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--project", "${PLUGIN_ROOT}", "--locked", "--offline", "--no-dev", "--no-env-file", "antipode-mcp", "--workspace", "~/.antipode/audio"],
      "env": { "UV_PROJECT_ENVIRONMENT": "${PLUGIN_DATA}/venv" }
    }
  }
}
